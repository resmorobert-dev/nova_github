FROM dunglas/frankenphp:1-php8.4-alpine

WORKDIR /app

# PDO MySQL permite conectar el PHP original con MySQL/TiDB externo.
RUN docker-php-ext-install pdo_mysql \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY . /app

RUN printf "upload_max_filesize=3M\npost_max_size=4M\nmax_execution_time=30\n" > "$PHP_INI_DIR/conf.d/nova.ini"

ENV PORT=80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
